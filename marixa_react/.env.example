# =====================================================================
# marixa-react - Biến môi trường Vite
#
# Copy thành .env.local (dev, không commit) hoặc đặt trong Vercel
# Project Settings -> Environment Variables (production).
# =====================================================================

# --- DEV local (chạy API .NET bằng dotnet run / VS Debug) ---
# Vite dev server (:5173) proxy /api + /uploads -> API backend
VITE_API_PROXY_TARGET=http://localhost:57432

# --- PROD (Vercel + Render API) ---
# Khi deploy Vercel, API chạy trên Render (khác origin) -> phải đặt URL tuyệt đối.
# VITE_API_BASE_URL=https://m-chamcon-api.onrender.com/api
#
# - Có VITE_API_BASE_URL  -> axiosClient gọi API Render bằng URL tuyệt đối (CORS đã bật).
# - KHÔNG có              -> axiosClient dùng "/api" tương đối (cùng origin, dev proxy / M.API/wwwroot).
#
# Ảnh chấm công (resolvePhotoUrl trong utils/photoUrl.js) tự derive origin từ API_BASE_URL.
