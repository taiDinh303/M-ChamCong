<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS web.config cho Somee (Windows hosting).
  - aspNetCoreModuleV2: mọi request đều đi qua .NET (M.API.dll)
  - Static files (React build) nằm trong wwwroot, IIS/ASP.NET serve trực tiếp
  - SPA fallback: route React Router không tồn tại file -> index.html
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceExists="false" requireAccess="None" />
      </handlers>

      <rewrite>
        <rules>
          <!-- Route SPA (VD /employees) không khớp file thật -> index.html.
               Điều kiện: file không tồn tại + không phải file extension + không phải API/uploads/swagger -->
          <rule name="SpaFallback" stopProcessing="true">
            <match url=".*" />
            <conditions>
              <add input="{REQUEST_FILENAME}" matchExpression="^$" />
              <add input="{REQUEST_URI}" pattern="^/(api|uploads|swagger)(/|$)" negate="true" />
              <add input="{URL}" pattern="\.[^/]+$" negate="true" />
            </conditions>
            <action type="Rewrite" url="/index.html" />
          </rule>
        </rules>
      </rewrite>

      <aspNetCore processPath="dotnet" arguments=".\M.API.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs">
        <!-- BUC environment: Production -> app load appsettings.Production.json (CSDL Somee).
             Neu thieu, IIS mac dinh dung Development -> load appsettings.json (CSDL local dev) -> 500. -->
        <environmentVariables>
          <add name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
