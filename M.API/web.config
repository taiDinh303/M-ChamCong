<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceExists="false" />
    </handlers>
    <aspNetCore processPath="dotnet" arguments=".\M.API.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs" />
  </system.webServer>
</configuration>
