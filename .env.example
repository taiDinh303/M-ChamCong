# Registry only: ASP.NET does not load .env. Use User Secrets in Development.
# Production defaults: API/appsettings.Production.json; hosting inputs: deploy/render.env.example.
ASPNETCORE_ENVIRONMENT=Development
DATABASE__PROVIDER=SqlServer
CONNECTIONSTRINGS__MYCNN=
JWTSETTINGS__KEY=
CORS__ALLOWEDORIGINS__0=http://localhost:5173
APPSETTINGS__CLIENTURL=http://localhost:5173
# Optional overrides, only when intentionally configured:
# BACKGROUNDJOBS__ENABLED=true
# SWAGGER__ENABLED=false
# DATAPROTECTION__KEYSDIRECTORY=
# STORAGE__PROVIDER=Supabase
# SUPABASE__URL=
# SUPABASE__SERVICEKEY=
# DATABASEINITIALIZATION__ENABLED=false
# SEED__ENABLED=false
